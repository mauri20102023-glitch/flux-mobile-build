{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flux-evolution-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FLUX_STATE",
        "class_name": "FluxState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FluxState"
      ]
    }
  ],
  "vars": {
    "FLUX_TEXT_PROVIDER": "workers-ai",
    "FLUX_VISION_PROVIDER": "workers-ai",
    "WORKERS_AI_TEXT_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "FLUX_PUBLIC_URL": "https://flux-evolution-preview.mauri20102023.workers.dev",
    "WORKERS_AI_FAST_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
    "WORKERS_AI_DEEP_MODEL": "@cf/openai/gpt-oss-120b"
  }
}
