{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flux-core-12",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FLUX_STATE",
        "class_name": "FluxState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FluxState"]
    }
  ],
  "vars": {
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "AI_FAST_MODEL": "gpt-5.6-luna",
    "AI_STANDARD_MODEL": "gpt-5.6-terra",
    "AI_DEEP_MODEL": "gpt-5.6-sol",
    "ELEVENLABS_VOICE_ID": "0UODmc3E7WJdP8dVJWTB",
    "ELEVENLABS_MODEL_ID": "eleven_flash_v2_5"
  }
}
